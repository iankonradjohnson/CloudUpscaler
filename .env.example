# CloudUpscaler MCP Server Environment Variables
# Copy this file to .env and fill in your credentials

# RunPod Configuration (Required for cloud mode)
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here

# Google Cloud Storage Configuration (Required for cloud mode)
GCS_BUCKET=your_gcs_bucket_name
GCS_PROJECT_ID=your_gcs_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcs-credentials.json

# Upscaler Mode (cloud or local)
UPSCALER_MODE=cloud
